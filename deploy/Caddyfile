# Public reverse proxy with automatic HTTPS. Replace the domain, then run Caddy on the host
# (or as an extra compose service) in front of the web container published on 127.0.0.1:8000.
parlament.example.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
