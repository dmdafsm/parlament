# Copy to .env (never commit .env). Used by compose.yaml.
POSTGRES_PASSWORD=change-me
# live = official sites; wayback = archived copies (development only, when a site is unreachable)
PARLAMENT_FETCH_MODE=live
# stop | skip (record bot-checked pages in data/blocked/, pause, go on)
PARLAMENT_ON_BLOCK=stop
# Local model for `parlament summarize` (OpenAI-compatible, e.g. mlx_lm.server; ADR 0006)
# PARLAMENT_LLM_URL=http://127.0.0.1:8091/v1
# PARLAMENT_LLM_LABEL=RoGemma3-4B-Instruct (OpenLLM-Ro)
DB_PORT=5432
WEB_PORT=8000
